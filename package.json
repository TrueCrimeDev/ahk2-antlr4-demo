{
  "name": "ahk2-antlr4-demo",
  "version": "1.0.0",
  "scripts": {
    "start": "parcel src/index.html --open",
    "build": "node -e \"require('fs').rmSync('docs',{recursive:true,force:true})\" && parcel build src/index.html --dist-dir docs --public-url ./ --no-source-maps && node scripts/root-index.mjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit -p .",
    "test:highlight": "node tests/highlight.test.mjs",
    "check:highlight-corpus": "tsx tests/highlight-corpus.mts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AutoHotkey v2 AST explorer built on Descolada's ANTLR4 grammar",
  "devDependencies": {
    "@types/codemirror": "^5.60.18",
    "@types/viz.js": "^2.1.5",
    "antlr4ng": "^3.0.16",
    "buffer": "^6.0.3",
    "parcel": "^2.15.4",
    "process": "^0.11.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "codemirror": "^5.65.21",
    "highlight.js": "11.9.0",
    "viz.js": "^2.1.2"
  }
}
